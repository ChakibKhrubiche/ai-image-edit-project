// Step 7: audit the examples of unsent drafts with the strict vision check (no WaveSpeed credits).
// Flags examples whose product is a hooded/one-piece garment, not faithful, absent, or showing a clear face.
//   node --env-file=.env scripts/outreach/7-audit.mts            report only
//   node --env-file=.env scripts/outreach/7-audit.mts --apply    drop flagged examples; drafts left with no example are deleted,
//                                                                 others must be rewritten with 5-draft --redo
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { DATA_DIR, loadStores, saveStores } from "./lib.mts";
import { checkResult, HARD_GARMENT } from "./vision.mts";

const apply = process.argv.includes("--apply");
const stores = await loadStores();
const targets = stores.filter((s) => s.draft && !s.draft.sentAt && s.examples?.length);

interface Flag { domain: string; title: string; why: string }
const flags: Flag[] = [];
const queue = targets.flatMap((s) => s.examples!.map((e) => ({ s, e })));

async function worker() {
  for (let item = queue.shift(); item; item = queue.shift()) {
    const { s, e } = item;
    try {
      if (HARD_GARMENT.test(`${e.productTitle} ${e.productHandle}`)) {
        flags.push({ domain: s.domain, title: e.productTitle, why: "hooded / one-piece garment" });
        continue;
      }
      const [product, result] = await Promise.all([
        readFile(join(DATA_DIR, e.productImagePath)),
        readFile(join(DATA_DIR, e.imagePath)),
      ]);
      const c = await checkResult(product, result, e.productTitle);
      if (!c.product_visible) flags.push({ domain: s.domain, title: e.productTitle, why: `product not visible: ${c.reason}` });
      else if (!c.product_faithful) flags.push({ domain: s.domain, title: e.productTitle, why: `not faithful: ${c.reason}` });
      else if (!c.face_blurred) flags.push({ domain: s.domain, title: e.productTitle, why: "clear face visible" });
    } catch (err) {
      flags.push({ domain: s.domain, title: e.productTitle, why: `check failed: ${err instanceof Error ? err.message : err}` });
    }
  }
}
await Promise.all([worker(), worker(), worker(), worker()]);

const total = targets.reduce((n, s) => n + s.examples!.length, 0);
console.log(`${flags.length} flagged of ${total} examples in ${targets.length} drafts`);
for (const f of flags.sort((a, b) => a.domain.localeCompare(b.domain))) {
  console.log(`- ${f.domain} | ${f.title.slice(0, 50)} | ${f.why.slice(0, 160)}`);
}

if (apply) {
  for (const s of targets) {
    const bad = new Set(flags.filter((f) => f.domain === s.domain).map((f) => f.title));
    if (!bad.size) continue;
    s.examples = s.examples!.filter((e) => !bad.has(e.productTitle));
    delete s.draft; // regenerated by 5-draft (needs >=1 example); stale HTML must not be sent
    console.log(`${s.domain}: ${s.examples.length} example(s) kept, draft removed`);
  }
  await saveStores(stores);
}
