{%- comment -%}
  Backend URL is a fixed technical value (the HijabTryOn production backend).
  It is intentionally NOT exposed as a theme setting so merchants can't change
  it by mistake. Update it here if the backend domain ever changes.
{%- endcomment -%}
{%- assign backend_url = "https://hijabtryon.com" -%}
{%- comment -%}
  A product sold in several colours often has a main image showing every colour (e.g. folded scarves side by side),
  which gives a poor try-on. Send the image of the selected variant instead: default = selected/first variant image,
  fallback = main product image; the JS picks the right one at click time from the map below (variant id -> image).
{%- endcomment -%}
{%- assign default_variant = product.selected_or_first_available_variant -%}
{%- assign default_image = default_variant.featured_image | default: product.featured_image -%}
{%- assign sep = "" -%}
{%- capture variant_images -%}
  {
  {%- for v in product.variants -%}
    {%- if v.featured_image -%}
      {{ sep }}"{{ v.id }}":"{{ v.featured_image | image_url: width: 1024 }}"
      {%- assign sep = "," -%}
    {%- endif -%}
  {%- endfor -%}
  }
{%- endcapture -%}
<div
  id="hijab-tryon-root"
  data-shop="{{ shop.permanent_domain }}"
  data-product-image="https:{{ default_image | image_url: width: 1024 }}"
  data-variant-images="{{ variant_images | strip | escape }}"
  data-default-variant="{{ default_variant.id }}"
  data-product-id="{{ product.id }}"
  data-backend-url="{{ backend_url }}"
  data-button-text="{{ block.settings.button_text }}"
></div>

{{ 'tryon-widget.css' | asset_url | stylesheet_tag }}
<style>
  .hijab-tryon-btn { background: {{ block.settings.button_color }}; color: {{ block.settings.button_text_color }}; }
  .hijab-tryon-btn:hover { background: {{ block.settings.button_color }}; filter: brightness(0.85); }
  .hijab-tryon-generate { background: {{ block.settings.button_color }}; color: {{ block.settings.button_text_color }}; }
  .hijab-tryon-generate:hover:not(:disabled) { background: {{ block.settings.button_color }}; filter: brightness(0.85); }
</style>
<script src="{{ 'tryon-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "HijabTryOn",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Try it on"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#F4BF00"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#1a1a1a"
    }
  ]
}
{% endschema %}
